{
  "manifest_version": 3,
  "name": "스타빈 POE 번역기",
  "description": "이 프로그램은 영문으로 되어 있는 POE 팬 사이트의 아이템 옵션 및 패시브 스킬 정보 등을 한글로 변환하여 사용자들이 빌드나 아이템 시세 정보를 더 쉽게 참고하여 플레이할 수 있도록 도와줍니다.",
  "version": "1.8",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/popup.png"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/jquery-3.7.1.min.js",
        "scripts/chrome_api.js",
        "scripts/common.js",
        "scripts/content.js"
      ],
      "matches": [
        "https://www.pathofexile.com/*",
        "https://www.poelab.com/*",
        "https://poe.ninja/*",
        "https://poemap.trade/*",
        "https://www.filterblade.xyz/*",
        "https://www.poewiki.net/*",
        "https://blight.raelys.com/*",
        "https://poe.mikelat.com/*",
        "https://www.poelab.com/*",
        "https://siveran.github.io/calc.html",
        "https://www.craftofexile.com/*",
        "https://poestack.com/*",
        "https://vilsol.github.io/timeless-jewels/*",
        "https://wealthyexile.com/*"
      ]
    }
  ]
}