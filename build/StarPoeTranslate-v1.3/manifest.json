{
  "manifest_version": 3,
  "name": "스타빈 POE 번역기",
  "description": "POE 영어 사이트가 불편해서, POE 전용 번역기를 개발했습니다.",
  "version": "1.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/popup.png"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/jquery-3.7.1.min.js",
        "scripts/content.js"
      ],
      "css": [
        "css/content.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}