{
  "manifest_version": 3,
  "name": "POE Translate",
  "description": "POE Translate",
  "version": "1.0.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/popup.png"
  },
  "content_scripts": [
    {
      "js": [
        "data/items.js",
        "scripts/jquery-3.7.1.js",
        "scripts/content.js"
      ],
      "css": [
        "css/content.css"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}